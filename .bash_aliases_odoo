#!/usr/bin/zsh
# Odoo aliases & functions, sourced from .bash_aliases, which defines the color vars first.

alias odoo-bin='~/Dev/src/odoo/odoo-bin'
alias psus='ssh 6914273@psus-tools.odoo.com'

# Interactive servers for the non-default envs, with binary/addons/ports from each .oenv.
function odoo-iap()     { OROOT=~/Dev/src/iap         _orun dev "$@" }
function odoo-odoofin() { OROOT=~/Dev/src/odoofin-env _orun dev "$@" }

# DB-taking functions target oes_<name>, accepting the prefix too: `otest oes_foo` == `otest foo`.
function _ostripdb() {
  echo "${1#oes_}"
}

# Test runs force an http server up, which without these ports would hit a running instance's DB.

# Env = a dir with a .oenv, resolved $OROOT > nearest .oenv above $PWD > ~/Dev/src (see CLAUDE.md).

# Resolve the active env root. Prints an absolute path, always succeeds.
function _oroot() {
  if [[ -n "$OROOT" ]]; then
    print -r -- "${OROOT:A}"
    return
  fi
  local dir="${PWD:A}"
  while [[ "$dir" == "$HOME"/* ]]; do
    if [[ -f "$dir/.oenv" ]]; then
      print -r -- "$dir"
      return
    fi
    dir="${dir:h}"
  done
  print -r -- "${HOME}/Dev/src"
}

# _oenv_get <key> [default] -- read a key out of the active env's .oenv
function _oenv_get() {
  local root=$(_oroot) key="$1" def="${2:-}" line
  if [[ -f "$root/.oenv" ]]; then
    line=$(grep -m1 "^${key}=" "$root/.oenv" 2>/dev/null)
    if [[ -n "$line" ]]; then
      print -r -- "${line#${key}=}"
      return
    fi
  fi
  print -r -- "$def"
}

function _oports() {
  local http=$(_oenv_get http_port 8869)
  print -r -- "--http-port=$http --gevent-port=$(_oenv_get gevent_port $((http + 3)))"
}

# Rebuild the env's .oenv[-test].conf, where "test" drops dev_mode because it kills QWeb caching.
function _oconf() {
  local root=$(_oroot) mode="${1:-dev}"
  local odoo_dir=$(_oenv_get odoo odoo)
  local addons=$(_oenv_get addons "enterprise,${odoo_dir}/addons")
  local http=$(_oenv_get http_port 8869)
  local gevent=$(_oenv_get gevent_port $((http + 3)))

  # relative addons entries -> absolute, preserving order
  local -a parts=(${(s:,:)addons}) abs=()
  local p
  for p in $parts; do
    [[ -z "$p" ]] && continue
    [[ "$p" == /* ]] && abs+=("$p") || abs+=("$root/$p")
  done

  local conf="$root/.oenv.conf"
  [[ "$mode" == test ]] && conf="$root/.oenv-test.conf"

  sed -e "s|^addons_path *=.*|addons_path = ${(j:,:)abs}|" \
      -e "s|^http_port *=.*|http_port = $http|" \
      -e "s|^gevent_port *=.*|gevent_port = $gevent|" \
      ~/.odoorc > "$conf"

  if [[ "$mode" == test ]]; then
    sed -i -e '/^dev_mode *=/d' -e '/^dev *=/d' "$conf"
  fi

  local extra=$(_oenv_get extra "")
  if [[ -n "$extra" ]]; then
    local -a lines=(${(s:;:)extra})
    local l
    for l in $lines; do
      [[ -n "$l" ]] && sed -i "/^\[options\]/a $l" "$conf"
    done
  fi

  print -r -- "$conf"
}

# Write the odoo language server config for the active env from its .oenv, printing the path.
function _oools() {
  local root=$(_oroot)
  local name=$(_oenv_get name "${root:t}")
  local odoo_dir=$(_oenv_get odoo odoo)
  local addons=$(_oenv_get addons "enterprise,${odoo_dir}/addons")
  local python=$(_oenv_get python "\${userHome}/.pyenv/versions/odoo/bin/python")

  # <odoo>/addons comes with odoo_path, so listing it again would duplicate the root.
  local -a paths=() parts=(${(s:,:)addons})
  local p
  for p in $parts; do
    [[ -z "$p" || "$p" == "${odoo_dir}/addons" ]] && continue
    paths+=("\"$p\"")
  done

  local toml="$root/odools.toml"
  cat > "$toml" <<EOF
# Generated from .oenv by \`oools\`, with paths relative to this file. Do not hand-edit.
[[config]]
name = "$name"
odoo_path = "$odoo_dir"
addons_paths = [${(j:, :)paths}]
addons_merge = "override"
python_path = "$python"
stdlib = "\${userHome}/.local/share/nvim/odoo/typeshed/stdlib"
additional_stubs = ["\${userHome}/.local/share/nvim/odoo/typeshed/stubs"]
additional_stubs_merge = "override"
tsserver_command = "$HOME/.local/share/nvim/mason/packages/typescript-language-server/node_modules/.bin/tsserver"
EOF

  print -r -- "$toml"
}

# Regenerate the odools.toml of the active env, or of every known env with --all.
function oools() {
  if [[ "${1:-}" == "--all" ]]; then
    local f
    for f in ${HOME}/Dev/src/.oenv ${HOME}/Dev/src/*/.oenv(N) ${HOME}/Dev/wt/*/.oenv(N); do
      print -r -- "${GREEN}$(OROOT="${f:h}" _oools)${NC}"
    done
    return
  fi
  _obanner
  print -r -- "${GREEN}$(_oools)${NC}"
}

# One-line env banner, yellow off the default env, so an implicitly-picked env is never silent.
function _obanner() {
  local root=$(_oroot)
  local name=$(_oenv_get name "${root:t}")
  local odoo_dir=$(_oenv_get odoo odoo)
  local bar_color=$YELLOW
  [[ "$root" == "${HOME}/Dev/src" ]] && bar_color=$GREEN

  local out="${bar_color}▏${NC}${BOLD}${CYAN}${name}${NC}"
  out+=" ${BLUE}:$(_oenv_get http_port 8869)${NC}"

  # Report the odoo checkout plus each addons entry's top dir, so every env describes itself.
  local addons=$(_oenv_get addons "enterprise,${odoo_dir}/addons")
  local -a repos=("$odoo_dir" ${${(s:,:)addons}%%/*})
  local d sha branch up pushdef
  for d in ${(u)repos}; do
    [[ -e "$root/$d/.git" ]] || continue
    sha=$(git -C "$root/$d" rev-parse --short=8 HEAD 2>/dev/null) || continue
    branch=$(git -C "$root/$d" rev-parse --abbrev-ref HEAD 2>/dev/null)
    [[ "$branch" == HEAD ]] && branch="detached"
    out+="  ${d} ${YELLOW}${sha}${NC}${GREEN}(${branch})${NC}"

    # A pr-<N> worktree pushes to the PR's own head branch, a skew that is invisible otherwise.
    pushdef=$(git -C "$root/$d" config --get push.default 2>/dev/null)
    up=$(git -C "$root/$d" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)
    if [[ "$pushdef" == nothing ]]; then
      out+="${RED}↛${NC}"
    elif [[ -n "$up" && "${up##*/}" != "$branch" ]]; then
      out+="${BLUE}→${up}${NC}"
    fi
  done
  print -r -- "$out"
}

# Run odoo-bin inside the active env: _orun [test] -- <odoo-bin args...>, all args passed through.
function _orun() {
  local mode=dev
  if [[ "$1" == test ]]; then mode=test; shift; fi
  [[ "$1" == "--" ]] && shift

  local root=$(_oroot)
  local odoo_dir=$(_oenv_get odoo odoo)
  local bin="$root/$odoo_dir/odoo-bin"

  if [[ ! -x "$bin" ]]; then
    print -r -- "${RED}no odoo-bin at ${YELLOW}${bin}${NC}" >&2
    print -r -- "${RED}(env root ${YELLOW}${root}${RED}; fix its .oenv 'odoo=' key)${NC}" >&2
    return 1
  fi

  _obanner
  local conf=$(_oconf "$mode")
  "$bin" -c "$conf" "$@"
}

# Show or set the env: bare lists them, <path|slug> exports OROOT, `-` restores implicit resolution.
function oenv() {
  local target="${1:-}"

  if [[ "$target" == "-" ]]; then
    unset OROOT
    print -r -- "${GREEN}OROOT unset${NC} (implicit resolution)"
    _obanner
    return
  fi

  if [[ -n "$target" ]]; then
    local root="$target"
    [[ -d "$root" ]] || root="$HOME/Dev/wt/$target"
    if [[ ! -f "$root/.oenv" ]]; then
      print -r -- "${RED}no .oenv at ${YELLOW}${root:A}${NC}" >&2
      return 1
    fi
    export OROOT="${root:A}"
    _obanner
    return
  fi

  _obanner
  print -r -- "${BOLD}known envs${NC}"
  local f r n
  for f in ${HOME}/Dev/src/.oenv ${HOME}/Dev/src/*/.oenv(N) ${HOME}/Dev/wt/*/.oenv(N); do
    r="${f:h}"
    n=$(grep -m1 '^name=' "$f" 2>/dev/null); n="${n#name=}"
    printf "  %s%-14s%s %s:%-6s%s %s\n" \
      "$CYAN" "${n:-${r:t}}" "$NC" "$BLUE" "$(grep -m1 '^http_port=' "$f" | cut -d= -f2)" "$NC" "$r"
  done
}

# Lowest free http port, skipping .oenv-claimed ones and the long-lived 8069, 6969 and 8049 pairs.
function _oport_free() {
  local -a taken=(8069 8572 6969 8073 8049 8549 8869 8872)
  local f p
  for f in ${HOME}/Dev/src/.oenv ${HOME}/Dev/src/*/.oenv(N) ${HOME}/Dev/wt/*/.oenv(N); do
    p=$(grep -m1 '^http_port=' "$f" 2>/dev/null | cut -d= -f2)
    [[ -n "$p" ]] && taken+=($p $((p + 3)))
  done
  for p in {8900..8990}; do
    if [[ -z "${taken[(r)$p]}" && -z "${taken[(r)$((p + 3))]}" ]]; then
      print -r -- "$p"
      return
    fi
  done
  print -r -- 8900
}

# Track the PR's head branch so a push updates the PR instead of inventing a pr-<N> branch on dev.
function _owt_wire_push() {
  local wt="$1" head="$2" owner="$3"
  local shared="$HOME/Dev/src/enterprise"

  git -C "$shared" config extensions.worktreeConfig true

  if [[ "$owner" == odoo-dev && "$head" == *-andg ]]; then
    git -C "$shared" fetch -q dev "$head" 2>/dev/null
    if git -C "$shared" show-ref -q --verify "refs/remotes/dev/$head"; then
      git -C "$wt" branch --set-upstream-to="dev/$head" >/dev/null || return 1
      git -C "$wt" config --worktree push.default upstream
      print -r -- "${GREEN}push → ${YELLOW}dev/$head${NC}"
      return
    fi
    print -r -- "${YELLOW}note: dev/$head not found; pushing is disabled here${NC}"
  fi

  git -C "$wt" config --worktree push.default nothing
  print -r -- "${YELLOW}push disabled${NC} ${BLUE}(not your branch -- a push would create a stray dev branch)${NC}"
}

# owt <slug> <ref|pr/N> [<odoo-ref>]: isolated env, odoo pinned to match since skew breaks loading.
function owt() {
  setopt local_options no_notify no_monitor

  local slug="${1:-}" ref="${2:-}" odoo_ref="${3:-}"
  if [[ -z "$slug" || -z "$ref" ]]; then
    print -r -- "usage: owt <slug> <ref> [<odoo-ref>]"
    print -r -- "  owt mx-xml pr/110030        # PR head in enterprise, date-matched odoo"
    print -r -- "  owt cl-edi 19.0-foo-andg    # a branch"
    return 1
  fi

  local root="$HOME/Dev/wt/$slug"
  if [[ -e "$root" ]]; then
    print -r -- "${RED}$root already exists${NC}" >&2
    return 1
  fi

  # Fetch into FETCH_HEAD, not the branch: it may be checked out elsewhere, which git refuses.
  local ent_ref="$ref"
  if [[ "$ref" == pr/* ]]; then
    local num="${ref#pr/}"
    ent_ref="pr-$num"
    print -r -- "${GREEN}fetching enterprise PR ${YELLOW}#$num${NC}"
    git -C "$HOME/Dev/src/enterprise" fetch -q origin "pull/$num/head" || return 1
    if git -C "$HOME/Dev/src/enterprise" show-ref -q --verify "refs/heads/$ent_ref"; then
      if [[ $(git -C "$HOME/Dev/src/enterprise" rev-parse "$ent_ref") \
            != $(git -C "$HOME/Dev/src/enterprise" rev-parse FETCH_HEAD) ]]; then
        print -r -- "${YELLOW}note: local $ent_ref differs from the PR head; using the local branch${NC}"
      fi
    else
      git -C "$HOME/Dev/src/enterprise" branch -q "$ent_ref" FETCH_HEAD || return 1
    fi
  else
    git -C "$HOME/Dev/src/enterprise" fetch -q origin || true
  fi

  local ent_sha
  ent_sha=$(git -C "$HOME/Dev/src/enterprise" rev-parse --verify "$ent_ref^{commit}" 2>/dev/null) || {
    print -r -- "${RED}enterprise: cannot resolve ${YELLOW}$ent_ref${NC}" >&2
    return 1
  }

  # Ask runbot which base batch the bundle forked from, since git timestamps only approximate it.
  git -C "$HOME/Dev/src/odoo" fetch -q origin || true

  # A dev branch is cut from its own version (saas-19.4-foo-andg -> saas-19.4), never from master.
  local base_branch bundle pr_owner pr_json
  if [[ "$ref" == pr/* ]]; then
    pr_json=$(gh pr view "${ref#pr/}" --repo odoo/enterprise \
      --json baseRefName,headRefName,headRepositoryOwner 2>/dev/null)
    base_branch=$(jq -r '.baseRefName // empty' <<<"$pr_json")
    bundle=$(jq -r '.headRefName // empty' <<<"$pr_json")
    pr_owner=$(jq -r '.headRepositoryOwner.login // empty' <<<"$pr_json")
  else
    bundle="$ent_ref"
    [[ "$ent_ref" =~ '^(master|saas-[0-9]+\.[0-9]+|[0-9]+\.[0-9]+)' ]] && base_branch="$match[1]"
  fi
  : ${base_branch:=master}

  if [[ -z "$odoo_ref" ]]; then
    if [[ -n "$bundle" ]]; then
      odoo_ref=$(python3 "$HOME/Dev/scratch/runbot-status/runbot_status.py" bundle "$bundle" --batches 1 2>/dev/null \
        | python3 -c "
import json,sys
try:
    b = json.load(sys.stdin)['batches'][0]
    print(next(c['commit'] for c in b['commits'] if c['repo'] == 'odoo'))
except Exception:
    pass
" 2>/dev/null)
      [[ -n "$odoo_ref" ]] && print -r -- "${GREEN}odoo pinned from runbot bundle ${YELLOW}${bundle}${NC} ${GREEN}-> ${YELLOW}${odoo_ref:0:12}${NC}"
    fi
  fi

  if [[ -z "$odoo_ref" ]]; then
    local base when
    git -C "$HOME/Dev/src/odoo" fetch -q origin "$base_branch" 2>/dev/null || true
    base=$(git -C "$HOME/Dev/src/enterprise" merge-base "$ent_sha" "origin/$base_branch" 2>/dev/null) \
      || base="$ent_sha"
    when=$(git -C "$HOME/Dev/src/enterprise" log -1 --format=%ct "$base")

    local before after b_sha a_sha b_d a_d
    before=$(git -C "$HOME/Dev/src/odoo" log "origin/$base_branch" --before="@$when" -1 --format='%H %ct')
    after=$(git -C "$HOME/Dev/src/odoo" log "origin/$base_branch" --after="@$when" --reverse --format='%H %ct' | head -1)
    b_sha=${before%% *}; a_sha=${after%% *}
    b_d=$(( when - ${${before##* }:-0} ))
    a_d=$(( ${${after##* }:-99999999} - when ))

    if [[ -n "$a_sha" && $a_d -lt $b_d ]]; then
      odoo_ref="$a_sha"
    else
      odoo_ref="$b_sha"
    fi
    print -r -- "${GREEN}odoo date-matched to ${BLUE}${base_branch}${NC}${GREEN}@fork ${YELLOW}$(date -d "@$when" '+%F %T')${NC} ${GREEN}-> ${YELLOW}${odoo_ref:0:12}${NC} ${BLUE}(approximate)${NC}"
  fi

  # The pinned commit may predate the local clone's fetch of it.
  git -C "$HOME/Dev/src/odoo" cat-file -e "${odoo_ref}^{commit}" 2>/dev/null \
    || git -C "$HOME/Dev/src/odoo" fetch -q origin "$base_branch"

  mkdir -p "$root"
  git -C "$HOME/Dev/src/enterprise" worktree add -q "$root/enterprise" "$ent_ref" || return 1
  git -C "$HOME/Dev/src/odoo" worktree add -q --detach "$root/odoo" "$odoo_ref" || return 1

  [[ "$ref" == pr/* ]] && _owt_wire_push "$root/enterprise" "$bundle" "$pr_owner"

  local port=$(_oport_free)
  cat > "$root/.oenv" <<EOF
name=$slug
odoo=odoo
addons=enterprise,odoo/addons
http_port=$port
gevent_port=$((port + 3))
EOF

  # Seed the confs and the LS profile so the env is usable from nvim before any shell run.
  OROOT="$root" _oconf dev >/dev/null
  OROOT="$root" _oconf test >/dev/null
  OROOT="$root" _oools >/dev/null

  print -r -- "${GREEN}env ${CYAN}${BOLD}$slug${NC}${GREEN} ready${NC}"
  OROOT="$root" _obanner
  print -r -- "  ${BOLD}cd $root${NC}   ${BLUE}# then otest/onew/oub just work${NC}"
}

# Tear down an env created by owt: owtrm <slug> [y], where y also drops oes_<slug> unprompted.
function owtrm() {
  local slug="${1:?usage: owtrm <slug> [y]}" auto="${2:-}"
  local root="$HOME/Dev/wt/$slug"

  [[ -d "$root" ]] || { print -r -- "${RED}no env at $root${NC}" >&2; return 1; }
  [[ "${OROOT:A}" == "${root:A}" ]] && unset OROOT

  # Note the throwaway pr-<N> branch before the checkout goes, so it can be cleaned up below.
  local ent_branch ent_sha
  ent_branch=$(git -C "$root/enterprise" rev-parse --abbrev-ref HEAD 2>/dev/null)
  ent_sha=$(git -C "$root/enterprise" rev-parse --short=11 HEAD 2>/dev/null)

  git -C "$HOME/Dev/src/enterprise" worktree remove --force "$root/enterprise" 2>/dev/null
  git -C "$HOME/Dev/src/odoo" worktree remove --force "$root/odoo" 2>/dev/null
  rm -rf "$root"
  print -r -- "${GREEN}removed env $slug${NC}"

  # Only ever pr-<N>: a named branch checked out in a worktree is real work.
  if [[ "$ent_branch" =~ '^pr-[0-9]+$' ]]; then
    if [[ -z $(git -C "$HOME/Dev/src/enterprise" branch -r --contains "$ent_sha" 2>/dev/null) ]]; then
      print -r -- "${YELLOW}$ent_branch is on no remote; keeping it${NC} ${BLUE}(git branch -D $ent_branch)${NC}"
    else
      git -C "$HOME/Dev/src/enterprise" branch -q -D "$ent_branch" 2>/dev/null \
        && print -r -- "${GREEN}deleted branch $ent_branch${NC} ${BLUE}(was $ent_sha)${NC}"
    fi
  fi

  if psql -lqt 2>/dev/null | cut -d\| -f1 | grep -qw "oes_$slug"; then
    if [[ "$auto" == y ]]; then
      ocleanup "$slug" y
    else
      print -r -- "${YELLOW}database oes_$slug still exists${NC} (ocleanup $slug)"
    fi
  fi
}

# Function to download a runbot database and restore it.
function orunbot() {
  zipname=$(basename "$1")
  dbname=oes_${zipname%.*}
  echo $dbname
  mkdir /tmp/restore-$dbname
  echo "### downloading"
  wget $1 -P /tmp/restore-$dbname -q
  unzip -q /tmp/restore-$dbname/$zipname -d /tmp/restore-$dbname
  echo "### restoring filestore"
  mkdir ~/.local/share/Odoo/filestore/$dbname
  mv /tmp/restore-$dbname/filestore/* ~/.local/share/Odoo/filestore/$dbname
  echo "### restoring db"
  createdb $dbname
  psql -q $dbname < /tmp/restore-$dbname/dump.sql
  echo "### cleaning"
  rm -r /tmp/restore-$dbname
  echo "Created db in $dbname"
}

# Function to drop a database and delete it's filestore folder
function ocleanup() {
  DB_NAME=$(_ostripdb "${1:-""}")
  PERFORM_CLEAN=${2:-""}
  if [[ "$DB_NAME" == "" ]] ; then
      echo "ERROR MUST SPECIFY DB NAME"
      return 1
  fi
  cwd=$(pwd)

  FS_FOLDER="${HOME}/.local/share/Odoo/filestore/oes_${DB_NAME}"
  echo \"$FS_FOLDER\"
  echo "killing connection to database $DB_NAME"
  psql -d postgres -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = 'oes_$DB_NAME';"

  echo "Dropping database $DB_NAME"
  dropdb oes_$DB_NAME --if-exists

  if [ -d "$FS_FOLDER" ]; then
    echo "Will delete database filestore at folder: $FS_FOLDER"
    if [[ "$PERFORM_CLEAN" =~ ^[Yy].*$ ]] ; then
      brave="y"
    else
      read "brave?Here be dragons. Continue? "
    fi

    if [[ "$brave" =~ ^[Yy].*$ ]] then
      echo "Deleting folder."
      rm -rf $FS_FOLDER
    else
      echo "Skipping delete"
    fi
  fi
  echo "Database $DB_NAME cleaned up."
}

# Create a new DB, passing extra args to odoo-bin. Check the target version out everywhere first.
function onew() {
  local DB_NAME=$(_ostripdb "${1:-""}")

  if [[ "$DB_NAME" == "" ]] ; then
      echo "usage: onew DB_NAME [odoo-bin args...]"
      return 1
  fi
  shift
  local cwd=$(pwd)

  ocleanup "$DB_NAME"

  # No http server unless a passed-through --test-enable forces one, so the ports cost nothing.
  _orun test -d oes_$DB_NAME ${=$(_oports)} "$@" --stop-after-init;
  cd $cwd
}

# otest DB [TAGS] [args...] where TAGS = :TestClass.test_func,/test_module, omit for every test.
function otest() {
  local DB_NAME=$(_ostripdb "${1:-""}")

  if [[ "$DB_NAME" == "" ]] ; then
    echo "usage: otest DB_NAME [TEST_TAGS] [odoo-bin args...]"
    return 1
  fi
  shift
  local TAGS=""
  if [[ $# -gt 0 && "$1" != -* ]]; then
    TAGS=$1
    shift
  fi
  local cwd=$(pwd)
  # Before "$@", so an explicit --http-port on the command line still wins.
  local -a PORTS=(${=$(_oports)})

  if [[ -n "$TAGS" ]]; then
    _orun test -d oes_$DB_NAME --test-tags "$TAGS" "${PORTS[@]}" "$@" --stop-after-init;
  else
    _orun test -d oes_$DB_NAME --test-enable "${PORTS[@]}" "$@" --stop-after-init;
  fi
  cd $cwd
}

# oub DB [MODULES] [args...]: upgrade comma-separated modules and exit, -u base by default.
function oub() {
  local DB_NAME=$(_ostripdb "${1:-""}")
  if [[ "$DB_NAME" == "" ]] ; then
    echo "usage: oub DB_NAME [MODULES] [odoo-bin args...]"
    return 1
  fi
  shift
  local MODULES=base
  if [[ $# -gt 0 && "$1" != -* ]]; then
    MODULES=$1
    shift
  fi
  local cwd=$(pwd)

  # As in onew: only binds if a passed-through --test-enable asks for it.
  _orun test -d oes_$DB_NAME -u "$MODULES" ${=$(_oports)} "$@" --stop-after-init;
  cd $cwd
}

# Pull every source repo in parallel, one summary line each, full git output only on failure.
function oupdate() {
    setopt local_options no_notify no_monitor
    set -o shwordsplit
    local ODOO_PATH=~/Dev/src
    local cwd=$(pwd)
    local ODOO_FOLDERS="enterprise odoo internal upgrade upgrade-util"

    local tmpdir
    tmpdir=$(mktemp -d)

    # Pull all folders in parallel - git pull already fetches, no need for separate fetch
    for folder in $ODOO_FOLDERS; do
        echo -e "${GREEN}Updating ${YELLOW}$folder${NC}${GREEN}...${NC}"
        (
            cd $ODOO_PATH/$folder
            git pull --ff-only > "$tmpdir/$folder.log" 2>&1
            echo $? > "$tmpdir/$folder.rc"
        ) &
    done
    wait

    # Print results in deterministic order; full log only on failure
    for folder in $ODOO_FOLDERS; do
        local rc=$(command cat "$tmpdir/$folder.rc")
        if [[ "$rc" != "0" ]]; then
            echo -e "${RED}FAILED: $folder (exit $rc)${NC}"
            command cat "$tmpdir/$folder.log"
        else
            local summary=$(command grep -E '^Already up to date|^Updating [0-9a-f]+\.\.|files? changed' \
                "$tmpdir/$folder.log" | sed 's/^ *//;s/^Updating //' | awk 'NR>1{printf ", "}{printf "%s",$0}')
            echo -e "${GREEN}Updated $folder${NC}${summary:+ ${GRAY}($summary)${NC}}"
        fi
    done

    rm -rf "$tmpdir"
    cd $cwd
}

# orebase <new-base> [<old-base>]: replay only your commits, old base inferred from the branch name.
function orebase() {
  setopt local_options rematchpcre

  local NEW_BASE="${1:-}"
  local OLD_BASE="${2:-}"

  if [[ -z "$NEW_BASE" ]]; then
    echo "ERROR: MUST SPECIFY VERSION"
    return 1
  fi

  local CURRENT_BRANCH
  CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

  if [[ -z "$OLD_BASE" ]]; then
    if [[ "$CURRENT_BRANCH" =~ '^(master|saas-\d+\.\d+|\d+\.\d+)-' ]]; then
      OLD_BASE="${match[1]}"
    else
      echo -e "${RED}ERROR: cannot infer old base from branch '$CURRENT_BRANCH'${NC}"
      echo "Pass it explicitly: orebase <new-base> <old-base>"
      return 1
    fi
  fi

  echo -e "${GREEN}Rebasing ${YELLOW}$CURRENT_BRANCH${NC}${GREEN} from ${BLUE}$OLD_BASE${NC}${GREEN} onto ${BLUE}$NEW_BASE${NC}${GREEN}...${NC}"

  git fetch origin "$NEW_BASE" "$OLD_BASE" || return $?
  git rebase --onto "origin/$NEW_BASE" "origin/$OLD_BASE" "$CURRENT_BRANCH"
}

# Search for a commit modifying some code with specific tags
function ogit() {
  STRING=${1:-""}
  DATE=${2:-""}
  GREP=${3:-"FIX"}
  if [[ "$STRING" == "" || "$DATE" == "" ]] ; then
    echo "ERROR: MUST SPECIFY STRING AND DATE"
    return 1
  fi

  git log -G "$STRING" --since="$DATE" --grep="$GREP" -p | egrep "(^commit [0-9a-f]+$)|diff --git|$STRING"
}

# Swap odoo + enterprise in parallel, falling back to the base version in the name. `-` = previous.
function oswitch() {
  setopt local_options no_notify no_monitor shwordsplit rematchpcre

  local ODOO_PATH=~/Dev/src
  local ODOO_FOLDERS="odoo enterprise"
  local VERSION=${1:-""}

  if [[ "$VERSION" == "" ]]; then
    echo "usage: oswitch <branch>   (- for previous branch)"
    return 1
  fi

  # Worktree envs are pinned on purpose: refuse, rather than switching the main checkouts from one.
  if [[ "$(_oroot)" != "$ODOO_PATH" ]]; then
    echo -e "${RED}refusing to oswitch: active env is ${YELLOW}$(_oroot)${NC}" >&2
    echo -e "${RED}use ${YELLOW}owt${NC}${RED} for a new pinned env, or ${YELLOW}cd ~/Dev/src${NC}" >&2
    return 1
  fi

  # odoo:master -> master, odoo-dev:master-foo-andg -> master-foo-andg
  VERSION=${VERSION##*:}

  local cwd=$(pwd)
  local tmpdir
  tmpdir=$(mktemp -d)

  # Switch folders in parallel - fetch + checkout are independent per folder
  for fold in $ODOO_FOLDERS; do
    echo -e "${GREEN}Swapping ${YELLOW}$fold${NC}${GREEN} to ${BLUE}$VERSION${NC}${GREEN}...${NC}"
    (
      cd $ODOO_PATH/$fold
      {
        git fetch > /dev/null 2>&1
        if [[ "$VERSION" == "-" ]] || \
           git show-ref --quiet refs/heads/$VERSION refs/remotes/origin/$VERSION; then
          git checkout $VERSION
        else
          [[ $VERSION =~ '^(master|(saas-)?\d+.\d+)' ]]
          local head=$match[1]
          if [[ -n "$head" ]] && git show-ref --quiet refs/heads/$head; then
            echo -e "${RED}Can't find ${YELLOW}$VERSION${NC}${RED} branch, using ${GREEN}$head${NC}"
            git checkout $head
          else
            echo -e "${RED}Can't find ${YELLOW}$VERSION${NC}${RED} branch and no base fallback${NC}"
          fi
        fi
      } > "$tmpdir/$fold.log" 2>&1
    ) &
  done
  wait

  # Prefix each line with the repo name so messages are attributable
  for fold in $ODOO_FOLDERS; do
    command sed "s/^/${YELLOW}${fold}${NC} | /" "$tmpdir/$fold.log"
  done

  rm -rf "$tmpdir"
  cd $cwd
}

# oinstall-pydevd <pyenv-name>: reinstall pydevd_plugin_odoo.py, which debugpy upgrades clobber.
oinstall-pydevd() {
  local env_name="${1:-odoo}"
  local src="$HOME/dotfiles/.config/nvim/scripts/pydevd_plugin_odoo.py"
  local env_root="$HOME/.pyenv/versions/$env_name"
  if [[ ! -f "$src" ]]; then
    echo "source plugin not found: $src" >&2
    return 1
  fi
  if [[ ! -d "$env_root" ]]; then
    echo "pyenv not found: $env_root" >&2
    return 1
  fi
  local dest_dir
  dest_dir=$(find "$env_root/lib" -maxdepth 8 -type d \
    -path '*/debugpy/_vendored/pydevd/pydevd_plugins/extensions' 2>/dev/null | head -1)
  if [[ -z "$dest_dir" ]]; then
    echo "debugpy vendored extensions dir not found in $env_root" >&2
    return 1
  fi
  cp "$src" "$dest_dir/" && echo "installed pydevd_plugin_odoo.py -> $dest_dir"
}

# omcp DB: point Claude Code's `odoo` MCP at oes_DB with a fresh key, then reconnect with /mcp.
function omcp() {
  "$HOME/.claude/hooks/odoo-mcp-sync.sh" "oes_$(_ostripdb "${1:?usage: omcp DB_NAME}")"
}

# olsup [BRANCH]: install odoo_ls_server (default alpha-1.5.0) + the typeshed commit it pins.
function olsup() {
  local branch=${1:-alpha-1.5.0}
  cargo install --git https://github.com/odoo/odoo-ls --branch "$branch" odoo_ls_server || return
  local pin=$(gh api "repos/odoo/odoo-ls/contents/server/typeshed?ref=$branch" -q .sha) || return
  git -C ~/.local/share/nvim/odoo/typeshed fetch -q origin &&
  git -C ~/.local/share/nvim/odoo/typeshed checkout -q "$pin" &&
  echo "odoo_ls_server ($branch) installed, typeshed @ ${pin:0:9}"
}

olist() {
    setopt local_options no_notify no_monitor
    local RESET=$'\033[0m'

    # Get list of databases (zsh splits on newlines automatically)
    local databases=(${(f)"$(psql -t -A -c "SELECT datname FROM pg_database WHERE datname LIKE 'oes_%' ORDER BY datname")"})

    # Create temp directory for results
    local tmpdir=$(mktemp -d)

    # Launch parallel queries for each database
    for dbname in $databases; do
        [[ -z "$dbname" ]] && continue
        (
            local version=$(psql -d "$dbname" -t -A -c \
                "SELECT replace((regexp_matches(latest_version, '^\d+\.\d+|^saas~\d+\.\d+|saas~\d+'))[1], '~', '-')
                 FROM ir_module_module WHERE name='base'" 2>/dev/null || echo "N/A")
            version=${version## }
            version=${version%% }
            echo "$dbname|$version" > "$tmpdir/$dbname"
        ) &
    done

    wait

    local db_data=()
    for dbname in $databases; do
        [[ -z "$dbname" ]] && continue
        [[ -f "$tmpdir/$dbname" ]] && db_data+=("$(cat "$tmpdir/$dbname")")
    done

    rm -rf "$tmpdir"
    print -n "\r\033[K"

    local output=""
    output+="${BOLD}╭──────────────────────────────────────────┬──────────────────────╮${NC}
"
    output+="$(printf "${BOLD}│${NC} ${BLUE}${BOLD}%-40s${NC} ${BOLD}│${NC} ${GREEN}${BOLD}%-20s${NC} ${BOLD}│${NC}" "Database Name" "Version")
"
    output+="${BOLD}├──────────────────────────────────────────┼──────────────────────┤${NC}
"

    for entry in $db_data; do
        local dbname=${entry%%|*}
        local version=${entry##*|}
        local prefix="oes_"
        local suffix="${dbname#$prefix}"
        output+="$(printf "${BOLD}│${NC} ${GRAY}oes_${CYAN}%-36s${NC} ${BOLD}│${NC} ${GREEN}%-20s${NC} ${BOLD}│${NC}" "$suffix" "$version")
"
    done

    output+="${BOLD}╰──────────────────────────────────────────┴──────────────────────╯${NC}"

    print -r "$output"
}

# --- zsh completion helpers ---
if [[ -n "$ZSH_VERSION" ]] && [[ -o interactive ]]; then
  _odoo_branches() {
    local -a branches
    local d
    for d in ~/Dev/src/odoo ~/Dev/src/enterprise; do
      [[ -d $d/.git ]] || continue
      branches+=(${(f)"$(git -C $d for-each-ref --format='%(refname:short)' \
        refs/heads refs/remotes 2>/dev/null | sed 's#^[^/]*/##')"})
    done
    branches=(${(u)branches})            # dedupe across repos
    _describe -t branches 'branch' branches
  }
  _oswitch() {
    _arguments '1:branch:_odoo_branches'
  }
  _orebase() {
    _arguments \
      '1:new base:_odoo_branches' \
      '2:old base:_odoo_branches'
  }
  # Existing oes_* databases, offered without the prefix, which _ostripdb accepts either way.
  _odoo_databases() {
    local -a dbs
    dbs=(${(f)"$(psql -t -A -d postgres -c \
      "SELECT substring(datname from 5) FROM pg_database WHERE datname LIKE 'oes\_%' ORDER BY 1" \
      2>/dev/null)"})
    _describe -t databases 'database' dbs
  }

  # Module names from the community + enterprise addons paths.
  _odoo_module_names() {
    local d
    local -a modules
    for d in ~/Dev/src/odoo/addons ~/Dev/src/odoo/odoo/addons ~/Dev/src/enterprise; do
      modules+=(${d}/*/__manifest__.py(N:h:t))
    done
    print -l -- ${(uo)modules}
  }

  # -u takes a comma-separated module list.
  _odoo_modules() {
    local -a modules
    modules=(${(f)"$(_odoo_module_names)"})
    _values -s , 'module' $modules
  }

  # --test-tags: comma-separated; only the /<module> form is completable.
  _odoo_test_tags() {
    compset -P '*,'
    if compset -P '/'; then
      local -a modules
      modules=(${(f)"$(_odoo_module_names)"})
      _describe -t modules 'module' modules
    else
      _message 'test tags (:TestClass.test_func, /module)'
    fi
  }

  _ocleanup() {
    _arguments \
      '1:database:_odoo_databases' \
      '2:delete filestore:(y n)'
  }
  _onew() {
    _arguments \
      '1:database:_odoo_databases' \
      '*::odoo-bin args:_default'
  }
  _otest() {
    _arguments \
      '1:database:_odoo_databases' \
      '2:test tags:_odoo_test_tags' \
      '*::odoo-bin args:_default'
  }
  _oub() {
    _arguments \
      '1:database:_odoo_databases' \
      '2:modules:_odoo_modules' \
      '*::odoo-bin args:_default'
  }
  _omcp() {
    _arguments '1:database:_odoo_databases'
  }

  compdef _oswitch oswitch
  compdef _orebase orebase
  compdef _ocleanup ocleanup
  compdef _onew onew
  compdef _otest otest
  compdef _oub oub
  compdef _omcp omcp
fi
